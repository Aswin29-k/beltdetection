# BeltGuard AI - Environment Configuration Example

# Google Gemini API Key (obtained from Google AI Studio)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Gemini Model Identifier
GEMINI_MODEL="gemini-3.8-flash"

# Backend Server Configuration
HOST="0.0.0.0"
PORT=8000
DB_PATH="conveyor_agent.db"

# Conveyor Mechanical Parameters
DEFAULT_BELT_SPEED_MPS=0.85
DEFAULT_BELT_LENGTH_MM=12000.0
CAMERA_TO_MARKER_DISTANCE_MM=1200.0
TRIANGULATION_SCALE_MM_PER_PX=0.22
